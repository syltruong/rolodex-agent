# Copy this to .env and fill in your values

TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# "openai" or "local"
LLM_BACKEND=openai

# --- OpenAI backend ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5.4-mini

# --- Local Langauge model backend ---
# Start with: mlx_lm.server --model <model-path> --port 8080
# LOCAL_BASE_URL=http://localhost:8080/v1
# or: ollama serve
LOCAL_BASE_URL=http://localhost:11434/v1
LOCAL_MODEL=gemma4:e4b-mlx
LOCAL_API_KEY=not-needed

# Absolute path to the root of your Obsidian vault (required for Obsidian tools)
# OBSIDIAN_VAULT_ROOT=/Users/you/Documents/MyVault
